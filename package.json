{
  "name": "netchaos",
  "version": "0.1.0",
  "description": "Break your network before it breaks your application. A Fetch-level network condition simulator for browser and Node.js apps.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "netchaos",
    "chaos-engineering",
    "network-simulation",
    "fetch",
    "latency",
    "testing",
    "resilience",
    "offline",
    "slow-3g",
    "developer-tools"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && vitest run tests/package.test.ts",
    "pack:check": "npm pack --dry-run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
